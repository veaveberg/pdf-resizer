{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Resizer",
  "version": "0.2.0",
  "identifier": "com.sashaberg.pdfresizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "PDF Resizer",
        "width": 600,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "minWidth": 600,
        "minHeight": 700,
        "maxWidth": 600,
        "maxHeight": 2000,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/AppIcon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "Resize PDF pages and export print-ready files.",
    "longDescription": "Resize, trim and export PDF pages and images on the web, macOS and Windows."
  }
}
